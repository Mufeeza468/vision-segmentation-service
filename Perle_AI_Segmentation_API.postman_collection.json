		{
			"name": "Annotations (CORE REQUIREMENTS)",
			"item": [
				{
					"name": "1. Save Annotation (Polygon Format)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"image_id\": \"{{imageId}}\",\n  \"project_id\": \"{{projectId}}\",\n  \"annotator_id\": \"64f123456789abcdef123456\",\n  \"label\": \"tree\",\n  \"mask\": {\n    \"format\": \"polygon\",\n    \"data\": {\n      \"exterior\": [[100, 100], [400, 100], [400, 500], [100, 500]],\n      \"holes\": []\n    },\n    \"width\": 1920,\n    \"height\": 1080\n  },\n  \"confidence\": 0.95,\n  \"status\": \"completed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/annotations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "annotations"]
						}
					},
					"response": []
				},
				{
					"name": "1. Save Annotation (RLE Format - SAM Compatible)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"image_id\": \"{{imageId}}\",\n  \"project_id\": \"{{projectId}}\",\n  \"annotator_id\": \"64f123456789abcdef123456\",\n  \"label\": \"elephant\",\n  \"mask\": {\n    \"format\": \"rle\",\n    \"data\": {\n      \"size\": [1080, 1920],\n      \"counts\": \"100,500,100,500,100,500,100\"\n    },\n    \"width\": 1920,\n    \"height\": 1080\n  },\n  \"confidence\": 0.92,\n  \"status\": \"completed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/annotations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "annotations"]
						}
					},
					"response": []
				},
